{
  "schema_version": "1.0",
  "ruleset_id": "base",
  "version": "1.0.0",
  "language": "en",
  "rules": [
    {
      "id": "clarity.due_to_the_fact_that_001",
      "enabled": true,
      "category": "clarity",
      "risk": "low",
      "operation": "replace_exact",
      "pattern": "due to the fact that",
      "replacement": "because",
      "case_sensitive": false,
      "priority": 100,
      "requires_review": false,
      "preserve_case": true,
      "source_note": "Replaces wordy cause-and-effect phrase with concise equivalent."
    },
    {
      "id": "clarity.in_order_to_002",
      "enabled": true,
      "category": "redundancy",
      "risk": "low",
      "operation": "replace_exact",
      "pattern": "in order to",
      "replacement": "to",
      "case_sensitive": false,
      "priority": 95,
      "requires_review": false,
      "preserve_case": true,
      "source_note": "Trims redundant infinitive marker."
    },
    {
      "id": "clarity.by_means_of_003",
      "enabled": true,
      "category": "clarity",
      "risk": "low",
      "operation": "replace_exact",
      "pattern": "by means of",
      "replacement": "using",
      "case_sensitive": false,
      "priority": 90,
      "requires_review": false,
      "preserve_case": true,
      "source_note": "Replaces verbose prepositional phrase."
    },
    {
      "id": "clarity.with_respect_to_004",
      "enabled": true,
      "category": "clarity",
      "risk": "low",
      "operation": "replace_exact",
      "pattern": "with respect to",
      "replacement": "regarding",
      "case_sensitive": false,
      "priority": 90,
      "requires_review": false,
      "preserve_case": true,
      "source_note": "Replaces cumbersome connective."
    },
    {
      "id": "clarity.as_mentioned_earlier_005",
      "enabled": true,
      "category": "style",
      "risk": "low",
      "operation": "replace_exact",
      "pattern": "as mentioned earlier",
      "replacement": "as noted above",
      "case_sensitive": false,
      "priority": 85,
      "requires_review": false,
      "preserve_case": true,
      "source_note": "Standardizes reference note."
    },
    {
      "id": "clarity.takes_into_account_006",
      "enabled": true,
      "category": "clarity",
      "risk": "low",
      "operation": "replace_exact",
      "pattern": "takes into account",
      "replacement": "considers",
      "case_sensitive": false,
      "priority": 85,
      "requires_review": false,
      "preserve_case": true,
      "source_note": "Replaces multi-word predicate with direct verb."
    },
    {
      "id": "clarity.a_large_number_of_007",
      "enabled": true,
      "category": "clarity",
      "risk": "low",
      "operation": "replace_exact",
      "pattern": "a large number of",
      "replacement": "numerous",
      "case_sensitive": false,
      "priority": 85,
      "requires_review": false,
      "preserve_case": true,
      "source_note": "Simplifies quantifier phrase."
    },
    {
      "id": "clarity.in_conclusion_008",
      "enabled": true,
      "category": "style",
      "risk": "low",
      "operation": "replace_exact",
      "pattern": "in conclusion",
      "replacement": "in summary",
      "case_sensitive": false,
      "priority": 80,
      "requires_review": false,
      "preserve_case": true,
      "source_note": "Replaces cliché transitional opener."
    },
    {
      "id": "clarity.it_is_worth_noting_that_009",
      "enabled": true,
      "category": "redundancy",
      "risk": "low",
      "operation": "replace_exact",
      "pattern": "it is worth noting that",
      "replacement": "importantly",
      "case_sensitive": false,
      "priority": 85,
      "requires_review": false,
      "preserve_case": true,
      "source_note": "Removes empty conversational lead-in."
    },
    {
      "id": "clarity.as_a_result_of_010",
      "enabled": true,
      "category": "clarity",
      "risk": "low",
      "operation": "replace_exact",
      "pattern": "as a result of",
      "replacement": "resulting from",
      "case_sensitive": false,
      "priority": 80,
      "requires_review": false,
      "preserve_case": true,
      "source_note": "Tightens causal phrase."
    }
  ]
}
