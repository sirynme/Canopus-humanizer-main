{
  "schema_version": "1.0",
  "ruleset_id": "academic",
  "version": "1.0.0",
  "language": "en",
  "rules": [
    {
      "id": "academic.this_research_paper_001",
      "enabled": true,
      "category": "style",
      "risk": "low",
      "operation": "replace_exact",
      "pattern": "this research paper",
      "replacement": "the present work",
      "case_sensitive": false,
      "priority": 100,
      "requires_review": false,
      "preserve_case": true,
      "source_note": "Scholarly self-reference formulation."
    },
    {
      "id": "academic.previous_studies_have_shown_002",
      "enabled": true,
      "category": "clarity",
      "risk": "low",
      "operation": "replace_exact",
      "pattern": "previous studies have shown",
      "replacement": "prior investigations have shown",
      "case_sensitive": false,
      "priority": 95,
      "requires_review": false,
      "preserve_case": true,
      "source_note": "Refines literature review phrasing."
    },
    {
      "id": "academic.has_been_widely_studied_003",
      "enabled": true,
      "category": "style",
      "risk": "low",
      "operation": "replace_exact",
      "pattern": "has been widely studied",
      "replacement": "has been extensively investigated",
      "case_sensitive": false,
      "priority": 90,
      "requires_review": false,
      "preserve_case": true,
      "source_note": "Enhances academic rigor."
    },
    {
      "id": "academic.it_has_been_reported_that_004",
      "enabled": true,
      "category": "clarity",
      "risk": "low",
      "operation": "replace_exact",
      "pattern": "it has been reported that",
      "replacement": "existing literature indicates that",
      "case_sensitive": false,
      "priority": 90,
      "requires_review": false,
      "preserve_case": true,
      "source_note": "Attributes finding to body of literature."
    },
    {
      "id": "academic.is_consistent_with_005",
      "enabled": true,
      "category": "clarity",
      "risk": "low",
